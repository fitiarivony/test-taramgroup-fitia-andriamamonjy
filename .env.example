# Token d'authentification pour l'API du CRM (Partie 2)
# Utilisé dans crmClient.js — jamais loggué, jamais exposé dans les erreurs
CRM_API_TOKEN=your_crm_api_token_here

# Secret utilisé pour vérifier la signature HMAC des webhooks de paiement (Partie 1, extrait C)
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
